{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.agentboard.desktop",
  "productName": "Agent Board",
  "copyright": "Copyright © 2026 Agent Board Contributors",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "package.json"
  ],
  "asar": true,
  "extraResources": [
    {
      "from": "dist/bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Agent Board"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "Development;Utility;",
    "synopsis": "Local multi-agent grid dashboard for Codex, Claude Code, and Antigravity",
    "description": "A lightweight, non-intrusive local AI session aggregation and interaction dashboard."
  }
}
